#!/bin/sh
# Plays an image's own starter in a fresh project, with no network: new,
# build, then a match against the practice rival. The project belongs to
# the caller, and so must everything the image writes into it.
set -eu
image=$1
project=$(mktemp -d)
trap 'rm -rf "$project"' EXIT
play() { docker run --rm --network none -v "$project":/bot "$image" "$@"; }

play version
play new
play build
play run
test -s "$project/replays/trial-42.json"
foreign=$(find "$project" ! -user "$(id -u)" | head -n 5)
if [ -n "$foreign" ]; then
  echo "Files in the project not owned by uid $(id -u):" >&2
  echo "$foreign" >&2
  exit 1
fi
